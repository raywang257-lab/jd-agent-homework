# OpenAI or an OpenAI-compatible endpoint. Leave API key empty to use the
# visibly labelled deterministic demo generator.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini

# SMTP settings for the real-email demo.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_SENDER=

# Comma-separated allowlist. The app refuses all other recipients.
ALLOWED_RECIPIENTS=your-test-email@example.com

